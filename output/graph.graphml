  <data key="d3">DESIGNED</data>
  <data key="d4">en_Philip_Johnson.md</data>
  <data key="d5">In 1980, Johnson and Burgee completed a cathedral in a dramatic new style: the Crystal Cathedral in Garden Grove, California, is a soaring glass megachurch originally built for the Reverend Robert H. Schuller.</data>
</edge>
<edge source="Person:philip johnson" target="Work:museum of television and radio" id="DESIGNED|1083">
  <data key="d3">DESIGNED</data>
