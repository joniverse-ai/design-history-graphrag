</edge>
<edge source="Person:ernesto basile" target="Work:villino florio" id="DESIGNED|174">
  <data key="d3">DESIGNED</data>
  <data key="d4">en_Art_Nouveau.md</data>
  <data key="d5">Examples of the Liberty style include the Villino Florio (1899–1902) by Ernesto Basile in Palermo; the Palazzo Castiglioni in Milan by Giuseppe Sommaruga (1901–1903); Milan, and the Casa Guazzoni (1904–05) in Milan by Giovanni Battista Bossi (1904–06).</data>
</edge>
