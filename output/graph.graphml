</edge>
<edge source="Person:오귀스트 페레" target="Work:샹젤리제 극장" id="DESIGNED|1259">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">1910년에서 1913년 사이 페레는 콘크리트 아파트 건물에서의 경험을 살려 몽테뉴가 15번지에 샹젤리제 극장을 건설했다.</data>
</edge>
<edge source="Person:오귀스트 페레" target="Work:샹젤리제 극장" id="DESIGNED|1279">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">이 건축 양식은 오귀스트 페레의 샹젤리제 극장(1910–13)과 함께 파리에서 처음 나타났으나 곧 유럽 전역으로 퍼져나가 런던에서 모스크바까지 거의 모든 대도시에서 사례를 찾을 수 있게 되었다.</data>
</edge>
<edge source="Person:앙드레 마르" target="Work:입체주의 하우스" id="DESIGNED|1250">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">파사드는 레몽 뒤샹비용이 설계했고, 내부 장식은 앙드레 마르가 맡았다.</data>
</edge>
<edge source="Person:앙드레 마르" target="Company:süe and mare" id="FOUNDED|1267">
  <data key="d3">FOUNDED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">앙드레 마르와 가구 디자이너 루이 쉬에는 전후에 자신들의 회사인 쉬에 앤 마르(Suë and Mare)를 설립했다.</data>
</edge>
<edge source="Person:루이 바릴레" target="Work:아메리칸 바 스테인드글라스 창문" id="DESIGNED|1252">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">입체파와 유사한 디자인은 닥스에 있는 아리움 카지노의 아메리칸 바 스테인드글라스 창문(1926)에서 루이 바릴레에 의해 제작되었는데, 여기에는 유행하는 칵테일의 이름도 포함되었다.</data>
</edge>
<edge source="Person:에밀 자크 룰만" target="Institution:장식 예술가 협회" id="FOUNDED|1253">
  <data key="d3">FOUNDED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">장식 예술가 협회를 설립한 가구 디자이너 에밀 자크 룰만, 장 뒤낭, 조각가 앙투안 부르델, 디자이너 폴 푸아레를 포함한 전통주의자들은 현대적인 형태를 전통적인 장인 정신 및 값비싼 재료와 결합했다.</data>
</edge>
<edge source="Person:폴 맨십" target="Work:프로메테우스 동상" id="DESIGNED|1255">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">그의 가장 유명한 작품은 뉴욕 록펠러 센터에 있는 프로메테우스 동상으로 고전적 주제를 20세기적으로 재해석한 것이다.</data>
</edge>
<edge source="Person:리 로리" target="Work:아틀라스 동상" id="DESIGNED|1256">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">록펠러 센터를 위한 다른 중요한 작품으로는 조각된 파사드와 아틀라스 동상을 제작한 리 로리가 있다.</data>
</edge>
<edge source="Person:폴 란도우스키" target="Work:구세주 그리스도상" id="DESIGNED|1257">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">가장 잘 알려져 있고 확실히 가장 큰 공공 아르데코 조각은 프랑스 조각가 폴 란도우스키에 의해 1922년에서 1931년 사이에 완공된 구세주 그리스도상으로, 브라질 리우데자네이루를 내려다보는 산 정상에 위치해 있다.</data>
</edge>
<edge source="Person:카상드르" target="Work:노르망디호 포스터" id="DESIGNED|1258">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">가장 잘 알려진 프랑스 아르데코 포스터 디자이너 중 한 명은 1935년 호화 원양 정기선 노르망디호의 유명한 포스터를 제작한 카상드르였다.</data>
</edge>
<edge source="Person:워트 c. 롤랜드" target="Work:가디언 빌딩" id="DESIGNED|1261">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">워트 C. 롤랜드가 설계한 이 건물은 전통적인 장식 대신 스테인리스강과 다채로운 색상의 디자인을 광범위하게 사용한 최초의 사례였다.</data>
</edge>
<edge source="Person:윌리엄 반 알렌" target="Work:크라이슬러 빌딩" id="DESIGNED|1262">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">뉴욕의 스카이라인은 윌리엄 반 알렌이 설계한 맨해튼의 크라이슬러 빌딩(1930년 완공)에 의해 획기적으로 바뀌었다.</data>
</edge>
<edge source="Person:윌리엄 f. 램" target="Work:엠파이어 스테이트 빌딩" id="DESIGNED|1263">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">크라이슬러 빌딩은 곧 윌리엄 F. 램의 엠파이어 스테이트 빌딩(1931)과 레이먼드 후드의 GE 빌딩(1933)에 의해 높이에서 추월당했다.</data>
</edge>
<edge source="Person:티모시 플루거" target="Work:450 서터 스트리트" id="DESIGNED|1265">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">샌프란시스코의 티모시 플루거가 설계한 450 서터 스트리트는 고도로 정형화된 형태의 마야 문명 건축에서 영감을 받았다.</data>
</edge>
<edge source="Person:도널드 데스키" target="Work:라디오 시티 뮤직 홀" id="DESIGNED|1266">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">도널드 데스키가 설계한 인테리어는 유리, 알루미늄, 크롬 및 가죽을 사용하여 시각적으로 현실로부터의 도피를 제공했다.</data>
</edge>
<edge source="Person:루이 쉬에" target="Company:süe and mare" id="FOUNDED|1268">
  <data key="d3">FOUNDED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">앙드레 마르와 가구 디자이너 루이 쉬에는 전후에 자신들의 회사인 쉬에 앤 마르(Suë and Mare)를 설립했다.</data>
</edge>
<edge source="Person:쥘 를뢰" target="Work:엘리제궁" id="DESIGNED|1269">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">쥘 를뢰는 1920년대에 아르데코로 매끄럽게 전환한 전통 가구 디자이너로, 엘리제궁의 가구를 디자인하기도 했다.</data>
</edge>
<edge source="Person:루이 마조렐" target="Work:강철 노동자를 묘사한 스테인드글라스 창문" id="DESIGNED|1270">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">루이 마조렐은 롱위에 있는 제강소 사무실을 위해 강철 노동자를 묘사한 주목할 만한 아르데코 스테인드글라스 창문을 디자인했다.</data>
</edge>
<edge source="Person:장 고댕" target="Work:아미앵 대성당 스테인드글라스 창문" id="DESIGNED|1271">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">아미앵 대성당에는 1932-34년에 파리의 유리 예술가 장 고댕이 제작한 아르데코 스테인드글라스 창문의 희귀한 사례가 성심 예배당에 남아 있다.</data>
</edge>
<edge source="Person:레몽 쉬브" target="Work:포르트 도레 궁전 입구" id="DESIGNED|1273">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">레몽 쉬브는 1931년 파리 식민지 박람회의 중심 건물인 포르트 도레 궁전 입구를 위해 우아한 금속 그릴을 디자인했다.</data>
</edge>
<edge source="Person:장 뒤낭" target="Work:〈사냥〉" id="DESIGNED|1274">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">프랑스 조각가 장 뒤낭은 석고 위에 금박과 페인트를 입힌 〈사냥〉이라는 주제의 웅장한 문들을 제작했다(1935).</data>
</edge>
<edge source="Person:후안 나크필" target="Work:아르데코 건물" id="DESIGNED|1275">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">그러나 필리핀에서는 후안 나크필, 후안 아레야노, 파블로 안토니오 등 현지 건축가들이 두드러졌다.</data>
</edge>
<edge source="Person:후안 아레야노" target="Work:아르데코 건물" id="DESIGNED|1276">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">그러나 필리핀에서는 후안 나크필, 후안 아레야노, 파블로 안토니오 등 현지 건축가들이 두드러졌다.</data>
</edge>
<edge source="Person:파블로 안토니오" target="Work:아르데코 건물" id="DESIGNED|1277">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">그러나 필리핀에서는 후안 나크필, 후안 아레야노, 파블로 안토니오 등 현지 건축가들이 두드러졌다.</data>
</edge>
<edge source="Person:프란시스코 j. 세라노" target="Work:건물" id="DESIGNED|1278">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">아르데코 주거 건축의 사례는 프란시스코 J. 세라노가 설계한 건물들이 많은 콘데사(Condesa) 지구에서 찾아볼 수 있다.</data>
</edge>
<edge source="Person:알베르 반 허펠" target="Work:국립 성심 대성당" id="DESIGNED|1281">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_아르데코.md</data>
  <data key="d5">1925년 건축가 알베르 반 허펠은 파리 현대 장식 미술 및 산업 미술 국제 박람회에서 이 성당의 축소 모델로 건축 부문 대상을 받았다.</data>
</edge>
<edge source="Person:oskar schlemmer" target="Work:삼부작 발레" id="DESIGNED|1282">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_오스카르_슐레머.md</data>
  <data key="d5">그의 가장 유명한 작품은 《삼부작 발레》(Triadisches Ballett)로, 배우들이 의상을 입고 등장하여 인간의 몸을 기하학적 형태로 표현한 공연이었다.</data>
</edge>
<edge source="Person:oskar schlemmer" target="Work:자기중심적 공간선" id="DESIGNED|1283">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_오스카르_슐레머.md</data>
  <data key="d5">이러한 탐구는 1924년의 《자기중심적 공간선》(Egocentric Space Lines) 같은 작품에서 드러난다.</data>
</edge>
<edge source="Person:oskar schlemmer" target="Work:바우하우스 계단" id="DESIGNED|1284">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_오스카르_슐레머.md</data>
  <data key="d5">1929년 바우하우스를 떠난 그는 브레슬라우 아카데미에서 《바우하우스 계단》(Bauhaustreppe, 1932, 뉴욕 근대미술관 소장) 등 대표작을 그렸다.</data>
</edge>
<edge source="Person:oskar schlemmer" target="Work:창문 그림" id="DESIGNED|1285">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_오스카르_슐레머.md</data>
  <data key="d5">그는 이 시기 집 창문 너머로 이웃들의 일상을 바라보며 그린 18점의 소형 회화 시리즈 《창문 그림》(Fensterbilder, 1942)을 남겼다.</data>
</edge>
<edge source="Person:oskar schlemmer" target="Work:이상적 만남" id="DESIGNED|1286">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_오스카르_슐레머.md</data>
  <data key="d5">1998년, 슐레머의 작품 《이상적 만남》(Idealistic Encounter)(1928)은 뉴욕 소더비 경매에서 148만 7천 달러에 낙찰되었다.</data>
</edge>
<edge source="Person:라이몬즈 치룰리스" target="Work:화산 암석 걸이 의자" id="DESIGNED|1287">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_의자.md</data>
  <data key="d5">라트비아의 인테리어 디자이너 라이몬즈 치룰리스(Raimonds Cirulis)는 화산암으로 수공으로 만든 화산 암석 걸이 의자를 만들었다.</data>
</edge>
<edge source="Person:피터 브레너" target="Work:막대사탕 설탕 의자" id="DESIGNED|1288">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_의자.md</data>
  <data key="d5">네덜란드 태생 독일 디자이너 피터 브레너(Peter Brenner)는 막대사탕 설탕 – 제과용 설탕 60 파운드 (27 kg) – 으로 만든 의자를 만들었다.</data>
</edge>
<edge source="Person:크리스토" target="Work:wrapped chair" id="DESIGNED|1289">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_의자.md</data>
  <data key="d5">크리스토는 1961년에 레디메이드 (의자), 래커, 캔버스, 로프, 페인트로 Wrapped Chair를 만들었다.</data>
</edge>
<edge source="Person:크리스토" target="Work:two wrapped chairs" id="DESIGNED|1290">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_의자.md</data>
  <data key="d5">이 작품과 유사한 의자를 포함한 여러 변형 작품이 전 세계 박물관에 전시되어 있으며, 1961년에 제작된 유사한 작품인 Two Wrapped Chairs도 있다.</data>
</edge>
<edge source="Person:조지프 코수스" target="Work:하나이면서 셋인 의자" id="DESIGNED|1291">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_의자.md</data>
  <data key="d5">하나이면서 셋인 의자, 1965년은 조지프 코수스가 만든 개념 예술 작품이다.</data>
</edge>
<edge source="Person:스티브 맨" target="Work:의자 조각" id="DESIGNED|1292">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_의자.md</data>
  <data key="d5">2001년, 스티브 맨은 샌프란시스코 미술관에 의자 조각을 전시했다.</data>
</edge>
<edge source="Person:요시오카 도쿠진" target="Work:허니팝" id="DESIGNED|1293">
  <data key="d3">DESIGNED</data>
  <data key="d4">ko_의자.md</data>
  <data key="d5">일본 디자이너 요시오카 도쿠진은 "허니팝": 벌집 종이 의자 (2001), "패인 의자": 천연 섬유 의자 (2006), "비너스": 천연 크리스탈 의자 (2007)와 같은 여러 의자를 예술 형태로 만들었다.</data>
</edge>
