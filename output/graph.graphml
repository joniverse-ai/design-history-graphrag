<edge source="Person:paul rand" target="Institution:pratt institute" id="STUDIED_AT|1049">
  <data key="d3">STUDIED_AT</data>
  <data key="d4">en_Paul_Rand.md</data>
  <data key="d5">Because Rand's father did not believe art could provide his son with a sufficient livelihood, he required Paul to attend Manhattan's Haaren High School while taking night classes at the Pratt Institute.</data>
</edge>
